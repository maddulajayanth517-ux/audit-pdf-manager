# Copy to .env and adjust. All values are optional.

# Where temporary working files are stored (default: <system temp>/audit_pdf_manager).
# Every upload gets its own random sub-folder that is deleted automatically.
APP_TEMP_DIR=

# Maximum upload size in MB (1 MB = 1,000,000 bytes).
MAX_UPLOAD_MB=1000

# Uploaded PDFs and generated volumes are deleted after this many minutes of inactivity.
FILE_TTL_MINUTES=60

# Delete leftovers in APP_TEMP_DIR when the server starts.
PURGE_ON_STARTUP=true

# Optional explicit path to Ghostscript (auto-detected when empty), e.g.
# GHOSTSCRIPT_PATH=C:\Program Files\gs\gs10.04.0\bin\gswin64c.exe
GHOSTSCRIPT_PATH=
GHOSTSCRIPT_TIMEOUT_S=600

# Number of PDFs processed at the same time (each in its own worker process).
MAX_CONCURRENT_JOBS=2

# Parallel compression worker processes per job (0 = automatic: CPU cores - 1, max 8).
WORKERS_PER_JOB=0

# Required free disk space as a multiple of the uploaded PDF size.
DISK_SPACE_FACTOR=4

# Only needed if a separate frontend is served from another origin (comma separated).
CORS_ORIGINS=

# Login (HTTP Basic). REQUIRED when the app is reachable from the internet.
# Leave APP_PASSWORD empty only when running on 127.0.0.1 for yourself.
APP_USERNAME=audit
APP_PASSWORD=
